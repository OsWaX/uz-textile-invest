{
  "name": "uz-textile-invest",
  "version": "1.0.0",
  "private": true,
  "description": "Портал управления проектами Проектного офиса заместителя министра по текстильной промышленности (Республика Узбекистан)",
  "type": "commonjs",
  "main": "server/index.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning server/index.js",
    "dev": "node --no-warnings=ExperimentalWarning --watch server/index.js",
    "seed": "node --no-warnings=ExperimentalWarning scripts/seed.js",
    "reset": "node --no-warnings=ExperimentalWarning scripts/seed.js --reset",
    "clean": "node --no-warnings=ExperimentalWarning scripts/clean.js",
    "test": "node --no-warnings=ExperimentalWarning --test --test-concurrency=1 tests/*.test.js"
  },
  "dependencies": {
    "pg": "8.13.1"
  },
  "license": "UNLICENSED"
}
