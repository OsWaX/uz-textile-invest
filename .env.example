# ==========================================================================
#  Портал Проектного офиса — пример конфигурации
#  Скопируйте файл в .env и заполните значения перед запуском в продакшене.
# ==========================================================================

# --- Сеть -----------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
# Для docker compose: на каком адресе хоста публиковать приложение.
BIND_ADDR=127.0.0.1
HOST_PORT=8081
# Внешний адрес системы (используется в письмах и уведомлениях)
PUBLIC_URL=http://localhost:3000

# --- Безопасность ---------------------------------------------------------
# ОБЯЗАТЕЛЬНО задайте случайную строку не короче 32 символов в продакшене.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Ставьте 1, если приложение работает за HTTPS-прокси (обязательно в продакшене)
SECURE_COOKIES=0
# Тайм-аут неактивной сессии, минут (настраивается также из панели администратора)
SESSION_TIMEOUT_MINUTES=30
# Блокировка учётной записи: число неудачных попыток и длительность блокировки (минут)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- PostgreSQL и хранение файлов -----------------------------------------
# В docker compose используется host postgres. Для запуска без Docker замените
# на postgres://portal:<пароль>@127.0.0.1:5432/uz_textile_portal
DATABASE_URL=postgres://portal:change_me@postgres:5432/uz_textile_portal
DB_POOL_SIZE=10
POSTGRES_DB=uz_textile_portal
POSTGRES_USER=portal
POSTGRES_PASSWORD=change_me
UPLOAD_DIR=./data/uploads
BACKUP_DIR=./backups
MAX_UPLOAD_MB=25

# --- Почтовые уведомления (SMTP) -----------------------------------------
# Пусто -> канал «почта» отключён, уведомления остаются только в системе.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=portal@textile.gov.uz

# --- Telegram-бот ---------------------------------------------------------
# Пусто -> канал «Telegram» отключён.
TELEGRAM_BOT_TOKEN=

# --- Первичная учётная запись администратора ------------------------------
# Используется только при первом создании базы данных.
ADMIN_EMAIL=admin@textile.gov.uz
ADMIN_PASSWORD=
