{
  "expo": {
    "name": "Jayron Kids",
    "slug": "jayron-kids",
    "version": "1.0.0",
    "scheme": "jayronkids",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF7E6",
    "primaryColor": "#00857A",
    "description": "Jayron Kids — qiziquvchan bolalar uchun qulay kiyimlar. Little steps, brighter tomorrows.",
    "ios": {
      "bundleIdentifier": "uz.jayronkids.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "uz.jayronkids.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFF7E6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FCF7EE",
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
