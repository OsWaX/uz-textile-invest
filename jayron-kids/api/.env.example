# =============================================================================
#  Jayron Kids — настройки сервера магазина
#  Скопируйте файл в .env и заполните значения.
# =============================================================================

# development | production
NODE_ENV=development
PORT=4000
# Внешний адрес сервера: на него Payme и Click возвращают покупателя после оплаты
PUBLIC_URL=http://localhost:4000
# За обратным прокси (nginx, Render, Fly.io): 1
TRUST_PROXY=0

DATABASE_URL=postgres://jayron:jayron@127.0.0.1:5432/jayron_kids

# Пароль панели управления /admin (в продакшене — не короче 10 символов)
ADMIN_PASSWORD=

# Адреса веб-версии приложения через запятую (для мобильных приложений не нужно)
CORS_ORIGINS=

# ---------------------------------------------------------------- магазин
SUPPORT_PHONE=+998 71 200 00 00
SUPPORT_TELEGRAM=jayronkids
SUPPORT_INSTAGRAM=jayronkids
PICKUP_ADDRESS_UZ=Toshkent sh., Chilonzor tumani, Bunyodkor ko‘chasi, 1
PICKUP_ADDRESS_RU=г. Ташкент, Чиланзарский район, улица Бунёдкор, 1
# Бесплатная доставка от суммы (сум) и минимальная сумма заказа
FREE_DELIVERY_FROM=500000
MIN_ORDER_TOTAL=50000
# Через сколько минут отменять неоплаченный онлайн-заказ
UNPAID_ORDER_TTL_MINUTES=60
# Ставка НДС в фискальном чеке Payme
VAT_PERCENT=12

# ---------------------------------------------------------------- SMS (Eskiz)
# Без этих настроек коды входа выводятся в журнал сервера (только разработка)
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# ---------------------------------------------------------------- Payme
# Кабинет Payme Business → Кассы → Настройки кассы.
# Адрес для запросов: <PUBLIC_URL>/api/payments/payme
PAYME_MERCHANT_ID=
PAYME_KEY=
# 1 — тестовая касса (checkout.test.paycom.uz)
PAYME_TEST=1

# ---------------------------------------------------------------- Click
# Кабинет Click Merchant → Сервисы.
# Prepare URL:  <PUBLIC_URL>/api/payments/click/prepare
# Complete URL: <PUBLIC_URL>/api/payments/click/complete
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# Учебная оплата без договоров с Payme и Click (в продакшене всегда выключена)
DEMO_PAYMENTS=1

# ---------------------------------------------------------------- Telegram
# Бот сообщает о новых заказах и оплатах в чат менеджеров
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
